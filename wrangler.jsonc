{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scenepin",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "workers_dev": true,
  "preview_urls": true
}
